{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "govuk/components/generic-header/macro.njk" import govukGenericHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <title>{% if title %}{{ title }} – {% endif %}{{ site.serviceName }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#0b0c0c">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% if site.gaMeasurementId %}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaMeasurementId }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ site.gaMeasurementId }}');
      </script>
    {% endif %}
  </head>
  <body class="govuk-template__body">
    <script>
      document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>

    {{ govukSkipLink({
      text: "Skip to main content",
      href: "#main-content"
    }) }}

    {{ govukGenericHeader({
      logoText: site.serviceName,
      url: "/"
    }) }}

    {% set homeIsCurrent = page.url === "/" %}
    {{ govukServiceNavigation({
      navigation: [
        {
          href: "/",
          text: "Home",
          current: homeIsCurrent
        }
      ]
    }) }}

    {% set phaseHtml %}
      This is a prototype. It is not an official government service.
    {% endset %}
    {{ govukPhaseBanner({
      tag: {
        text: site.phase
      },
      html: phaseHtml
    }) }}

    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content" role="main">
        {% block content %}{% endblock %}
      </main>
    </div>

    {% set reportProblemHref = site.contactUrl + "?utm_source=" + site.appSlug %}
    {% set footerHtml %}
      <p class="govuk-body-s">
        Prototype. Not an official government service.
        <a class="govuk-footer__link" href="https://www.peterkappus.com/?utm_source={{ site.appSlug }}">Made by Peter Kappus</a>.
      </p>
    {% endset %}
    {{ govukFooter({
      navigation: [
        {
          title: "Explore",
          width: "full",
          items: [
            { href: "/", text: "Home" }
          ]
        }
      ],
      meta: {
        visuallyHiddenTitle: "Support links",
        items: [
          {
            href: reportProblemHref,
            text: "Report a problem"
          }
        ],
        html: footerHtml
      },
      contentLicence: null
    }) }}

    <script type="module" src="/assets/govuk-frontend.min.js"></script>
    <script type="module">
      import { initAll } from '/assets/govuk-frontend.min.js'
      initAll()
    </script>
  </body>
</html>
